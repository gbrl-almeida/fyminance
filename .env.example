# Configuração do Fyminance.
# Copie este arquivo para um arquivo chamado .env (na mesma pasta) e preencha o que for usar.
# Linha que começa com # é comentário e não vale. Para ligar uma opção, tire o # do começo.

# ---------------------------------------------------------------
# Nomes que aparecem na tela.
# Depois de mudar, rode de novo: pnpm web:build
# ---------------------------------------------------------------
NEXT_PUBLIC_NOME_PESSOA1=Pessoa 1
NEXT_PUBLIC_NOME_PESSOA2=Pessoa 2

# ---------------------------------------------------------------
# Onde ficam os seus dados. Sem esta linha, ficam na pasta padrão
# (.local/share/fyminance dentro da sua pasta de usuário).
# Para testar com dados de exemplo, use: FYMINANCE_DATA_DIR=demo
# ---------------------------------------------------------------
# FYMINANCE_DATA_DIR=demo

# ---------------------------------------------------------------
# Opcional: puxar extrato e fatura sozinho, pela Pluggy (Open Finance).
# Veja a seção "Ligar os bancos" do README.
# ---------------------------------------------------------------
# PLUGGY_CLIENT_ID=
# PLUGGY_CLIENT_SECRET=
# Uma conexão por banco, separadas por vírgula, no formato pessoa:banco:itemId
# FYMINANCE_CONNECTIONS=pessoa1:Nubank:cole-o-item-id-aqui,pessoa2:Inter:outro-item-id

# Se a pessoa 2 tiver a própria conta na Pluggy, as conexões dela usam estas:
# PLUGGY_CLIENT_ID_PESSOA2=
# PLUGGY_CLIENT_SECRET_PESSOA2=

# ---------------------------------------------------------------
# Opcional: IA que sugere a categoria do que as regras não pegaram (OpenRouter).
# Custa centavos de dólar por mês. O teto abaixo limita o gasto por execução.
# ---------------------------------------------------------------
# OPENROUTER_API_KEY=
# FYMINANCE_MODEL=google/gemini-2.5-flash-lite
# FYMINANCE_MODEL_MAX_COST_USD=0.5

# ---------------------------------------------------------------
# Opcional: ajudam a separar transferência entre vocês de gasto de verdade.
# ---------------------------------------------------------------
# CPFs da casa, separados por vírgula. Pix entre esses CPFs vira transferência, não gasto.
# FYMINANCE_HOUSEHOLD_DOCUMENTS=000.000.000-00,111.111.111-11
# Se alguém tem PJ: o CNPJ e um pedaço do nome da empresa, para reconhecer o que o PJ paga como renda.
# FYMINANCE_PJ_CNPJ=00.000.000/0001-00
# FYMINANCE_PJ_NAME=minha empresa ltda

# ---------------------------------------------------------------
# Opcional: vale-alimentação. Valor mensal em centavos (800 reais = 80000).
# A cada "pnpm fy sync", entra como renda e como gasto em Alimentação, e você confere no fechamento.
# Só funciona junto com a Pluggy.
# ---------------------------------------------------------------
# FYMINANCE_VOUCHER_MONTHLY_CENTS=80000

# ---------------------------------------------------------------
# Opcional: backup criptografado com o programa age (https://age-encryption.org).
# ---------------------------------------------------------------
# FYMINANCE_BACKUP_DIR=
# FYMINANCE_AGE_RECIPIENT=
